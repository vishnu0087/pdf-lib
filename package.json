{
  "name": "pdf-lib",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:pdf-css": "node ./pdf/build-print-css.mjs",
    "build:editor": "vite build --config vite.template-editor.config.ts && node ./copy-tinymce.mjs",
    "prestart": "npm run build:pdf-css && npm run build:editor",
    "start": "node --import tsx server.js"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.2.8",
    "@tinymce/tinymce-react": "^6.3.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "mongodb": "^6.21.0",
    "puppeteer": "^24.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tinymce": "^8.5.0",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^8.0.10"
  }
}
